# Vorlage für ~/fotos-web/.env auf dem Server (niemals committen).

# Adresse der Website; Caddy holt das Zertifikat (DNS-A-Eintrag auf den Server, "DNS only")
DOMAIN=fotos.example.ch

# Schreibgeschützter Immich-Schlüssel (Kontoeinstellungen → API-Schlüssel), NUR diese Berechtigungen:
#   album.read, asset.read, asset.view, asset.download, person.read
IMMICH_API_KEY=

# Optional: erscheint im Fuss ("Foto soll weg? Schreib uns")
CONTACT_EMAIL=
