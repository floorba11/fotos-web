# Vorlage für ~/fotos-web/.env auf dem Server (niemals committen).

# Adresse der Website; Caddy holt das Zertifikat (DNS-A-Eintrag auf den Server, bei Cloudflare "Proxied" = orange Wolke,
# damit die Besuche in den Cloudflare-Analytics erscheinen)
DOMAIN=fotos.example.ch

# Schreibgeschützter Immich-Schlüssel (Kontoeinstellungen → API-Schlüssel), NUR diese Berechtigungen:
#   album.read, asset.read, asset.view, asset.download, person.read
IMMICH_API_KEY=

# Optional: erscheint im Fuss ("Foto soll weg? Schreib uns")
CONTACT_EMAIL=

# Optional: Passwort für die Statistik unter https://<DOMAIN>/statistik (Aufrufe und Downloads pro Album).
# Beim Öffnen fragt der Browser nach Benutzername (egal) und Passwort. Leer = Statistik-Seite abgeschaltet
# (gezählt wird trotzdem). Ein langes, zufälliges Passwort wählen, z.B.: openssl rand -base64 18
STATS_PASSWORD=

# Optional: Ordner mit den Kaderporträts auf dem Server (Standard: Ordner _Portraits der Storage Box)
# PORTRAITS_SOURCE=/mnt/fotos/_Portraits
